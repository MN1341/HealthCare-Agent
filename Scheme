import torch
from transformers import pipeline

MODEL_ID = "google/medgemma-27b-text-it"

medgemma = pipeline(
    "text-generation",
    model=MODEL_ID,
    torch_dtype=torch.bfloat16,
    device_map="auto"
)

def analyze_medical_information(text: str) -> str:
    messages = [
        {
            "role": "system",
            "content": (
                "You are a medical information analysis assistant. "
                "Explain supplied medical information accurately. "
                "Distinguish documented facts from interpretations. "
                "Do not provide definitive diagnoses or prescribe treatment."
            )
        },
        {
            "role": "user",
            "content": text
        }
    ]

    result = medgemma(
        text=messages,
        max_new_tokens=500
    )

    return result[0]["generated_text"][-1]["content"]

